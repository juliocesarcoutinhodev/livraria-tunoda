                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    console.log(\"Usuario autenticado:\");",
                  "    console.log(\"- ID: \" + jsonData.id);",
                  "    console.log(\"- Email: \" + jsonData.email);",
                  "    console.log(\"- Role: \" + jsonData.role);",
                  "    ",
                  "    pm.test(\"Usuario retornado com sucesso\", function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    ",
                  "    pm.test(\"ID do usuario presente\", function () {",
                  "        pm.expect(jsonData.id).to.not.be.empty;",
                  "    });",
                  "    ",
                  "    pm.test(\"Email do usuario presente\", function () {",
                  "        pm.expect(jsonData.email).to.not.be.empty;",
                  "    });",
                  "    ",
                  "    pm.test(\"Role do usuario presente\", function () {",
                  "        pm.expect(jsonData.role).to.not.be.empty;",
                  "    });",
                  "} else if (pm.response.code === 401) {",
                  "    console.log(\"Nao autenticado - token invalido ou expirado\");",
                  "} else {",
                  "    console.log(\"Erro ao buscar usuario: \" + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
