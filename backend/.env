# ========================================
# Postgres (Docker Compose)
# ========================================
POSTGRES_USER=livraria_user
POSTGRES_PASSWORD=livraria_password
POSTGRES_DB=livraria_db
POSTGRES_PORT=5432
# Para Docker Compose: usar 'postgres' (nome do servico)
# Para execucao local fora do Docker: usar 'localhost'
POSTGRES_HOST=postgres

# ========================================
# APLICACAO
# ========================================
SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080

APP_IMAGE=juliocesarcoutinho/livraria-tunoda:staging

# ========================================
# DATABASE CONNECTION
# ========================================
# A URL sera construida usando POSTGRES_HOST do ambiente
# Docker Compose: POSTGRES_HOST=postgres
# Local: POSTGRES_HOST=localhost
JDBC_DATABASE_URL="jdbc:postgresql://${POSTGRES_HOST}:5432/${POSTGRES_DB}"

# ========================================
# SEGURANCA E AUTENTICACAO
# ========================================
# JWT_SECRET deve ter no mínimo 256 bits (32 caracteres)
# Chave gerada criptograficamente com OpenSSL (384 bits)
JWT_SECRET=yaMXBdR9qhul1Q0CnN/S08mO7AOF29SF5Jl1Cso8vYnM5tON2w3oqovU12u8R+76
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ========================================
# CORS (Cross-Origin Resource Sharing)
# ========================================
# Origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With
CORS_EXPOSED_HEADERS=Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

