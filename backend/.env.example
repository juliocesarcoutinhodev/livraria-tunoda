# ========================================
# CONFIGURAÇÕES DO POSTGRESQL (Docker Compose)
# ========================================
POSTGRES_USER=livraria_user
POSTGRES_PASSWORD=livraria_password
POSTGRES_DB=livraria_db
POSTGRES_PORT=5432

# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================
# Perfil ativo: local | dev | staging | production
SPRING_PROFILES_ACTIVE=local

# Porta do servidor
SERVER_PORT=8080

# ========================================
# SEGURANÇA E AUTENTICAÇÃO (OBRIGATÓRIO)
# ========================================
# Secret key para JWT - MÍNIMO 256 bits (32 caracteres)
# GERE UMA CHAVE SEGURA E NUNCA COMPARTILHE!
# Exemplo válido com 256+ bits:
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-256-bits-required-change-in-production-hs256-algorithm

# Expiração do JWT em segundos (default: 3600 = 1 hora)
JWT_EXPIRATION=3600

# Expiração do Refresh Token em dias (default: 30 dias)
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ========================================
# CORS (Cross-Origin Resource Sharing)
# ========================================
# Origens permitidas para acesso cross-origin (separadas por vírgula)
# Local: múltiplas portas para desenvolvimento
# Production: apenas domínio de produção
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200

# Métodos HTTP permitidos
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Headers permitidos nas requisições
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With

# Headers expostos nas respostas
CORS_EXPOSED_HEADERS=Authorization

# Permitir envio de credenciais (cookies, auth headers)
CORS_ALLOW_CREDENTIALS=true

# Tempo de cache da configuração CORS (em segundos)
CORS_MAX_AGE=3600

# ========================================
# MELHOR ENVIO - INTEGRAÇÃO DE FRETE (OBRIGATÓRIO)
# ========================================
# Token de API do Melhor Envio
# Sandbox: https://sandbox.melhorenvio.com.br
# Produção: https://melhorenvio.com.br
MELHOR_ENVIO_TOKEN=seu-token-aqui

# Base URL da API
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br

# CEP de origem dos envios (com ou sem hífen)
MELHOR_ENVIO_FROM_CEP=03295-000

# Timeout em segundos (default: 10)
MELHOR_ENVIO_TIMEOUT_SECONDS=10

# Máximo de tentativas em caso de falha (default: 2)
MELHOR_ENVIO_MAX_RETRIES=2

# Dimensões padrão para livros (em cm)
MELHOR_ENVIO_DEFAULT_WIDTH=15
MELHOR_ENVIO_DEFAULT_HEIGHT=2
MELHOR_ENVIO_DEFAULT_LENGTH=20

# Endpoint da API (geralmente não precisa mudar)
MELHOR_ENVIO_CALCULATE_ENDPOINT=/api/v2/me/shipment/calculate

# ========================================
# MERCADO PAGO - PAGAMENTOS (OBRIGATÓRIO)
# ========================================
# Access Token do Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers
MERCADO_PAGO_ACCESS_TOKEN=seu-access-token-aqui

# Base URL da API
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# Timeout em segundos (default: 15)
MERCADO_PAGO_TIMEOUT_SECONDS=15

# Máximo de tentativas em caso de falha (default: 2)
MERCADO_PAGO_MAX_RETRIES=2

# URLs de callback (frontend)
MERCADO_PAGO_SUCCESS_URL=http://localhost:3000/payment/success
MERCADO_PAGO_FAILURE_URL=http://localhost:3000/payment/failure
MERCADO_PAGO_PENDING_URL=http://localhost:3000/payment/pending

# URL de notificação (webhook) - deve ser pública em produção
# Use ngrok para desenvolvimento: https://ngrok.com
MERCADO_PAGO_NOTIFICATION_URL=http://localhost:8080/api/webhooks/mercadopago

# Nome da empresa que aparece na fatura
MERCADO_PAGO_STATEMENT_DESCRIPTOR=Livraria Tunoda

# Endpoints da API (geralmente não precisa mudar)
MERCADO_PAGO_CREATE_PREFERENCE_ENDPOINT=/checkout/preferences
MERCADO_PAGO_GET_PAYMENT_ENDPOINT=/v1/payments/{id}


# ========================================
# CNPJÁ - CONSULTA DE CEP (OBRIGATORIO)
# ========================================
CNPJA_API_URL=https://api.cnpja.com
CNPJA_API_TOKEN=sua-chave-de-api-aqui
CNPJA_TIMEOUT_SECONDS=10
CNPJA_ZIP_ENDPOINT=/zip/{code}

# ========================================
# LOGGING (OPCIONAL)
# ========================================
# Níveis de log para gateways externos (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL_MELHOR_ENVIO=INFO
LOG_LEVEL_MERCADO_PAGO=INFO

# ========================================
# PRODUÇÃO (apenas se SPRING_PROFILES_ACTIVE=production)
# ========================================
# URL completa do banco de dados em produção
# Exemplo: jdbc:mysql://seu-host.com:3306/livraria_db?useSSL=true&serverTimezone=UTC
JDBC_DATABASE_URL=jdbc:mysql://localhost:3306/livraria_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ========================================
# OBSERVAÇÕES IMPORTANTES
# ========================================
# 1. NUNCA versione o arquivo .env com credenciais reais
# 2. Use senhas fortes em produção
# 3. Em produção, use SSL/TLS na conexão com o banco
# 4. Gere um JWT_SECRET único e seguro (mínimo 256 bits)
# 5. Configure MERCADO_PAGO_NOTIFICATION_URL com URL pública
# 6. Em produção, use MELHOR_ENVIO_BASE_URL=https://melhorenvio.com.br
# 7. Em produção, use MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
# 8. Valide todas as variáveis antes de subir em produção
