# ========================================
# CONFIGURAÇÕES DO MYSQL (Docker Compose)
# ========================================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=livraria_db
MYSQL_USER=livraria_user
MYSQL_PASSWORD=livraria_password
MYSQL_PORT=3306

# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================
# Perfil ativo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ========================================
# MELHOR ENVIO - INTEGRAÇÃO DE FRETE
# ========================================
# Token de API do Melhor Envio (obtenha em: https://sandbox.melhorenvio.com.br)
# Para desenvolvimento use o sandbox, para produção use: https://melhorenvio.com.br
MELHOR_ENVIO_TOKEN=seu-token-aqui
# CEP de origem dos envios (sem hífen ou apenas números)
MELHOR_ENVIO_FROM_CEP=01310-100

# ========================================
# PRODUÇÃO (apenas se SPRING_PROFILES_ACTIVE=prod)
# ========================================
# URL completa do banco de dados em produção
# Exemplo: jdbc:mysql://seu-host.com:3306/livraria_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
JDBC_DATABASE_URL=jdbc:mysql://localhost:3306/livraria_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ========================================
# OBSERVAÇÕES
# ========================================
# 1. NUNCA versione o arquivo .env com credenciais reais
# 2. Use senhas fortes em produção
# 3. Em produção, use SSL/TLS na conexão com o banco
# 4. Ajuste o serverTimezone conforme sua localização

